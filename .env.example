# ---- shared ----
NODE_ENV=development

# ---- Postgres (docker-compose) ----
POSTGRES_USER=bow
POSTGRES_PASSWORD=bowpass
POSTGRES_DB=bowdb
DATABASE_URL=postgresql://bow:bowpass@localhost:5432/bowdb?schema=public

# ---- API (apps/api) ----
API_PORT=3001
JWT_SECRET=change-me-to-32-random-chars-minimum
JWT_EXPIRES_IN=7d
# '*' = allow all mail IDs (gmail, yahoo, college...). Or restrict: college.edu,cs.college.edu
ALLOWED_EMAIL_DOMAINS=*
# single emails bypassing domain check (comma-separated, for admins/demos)
ALLOWED_EMAIL_OVERRIDES=
FRONTEND_URL=http://localhost:3000
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# ---- GitHub OAuth (optional for MVP; repos endpoint returns fixtures if unset) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
