# ---- shared ----
NODE_ENV=development

# ---- Database ----
# Local docker: postgresql://bow:bowpass@localhost:5432/bowdb?schema=public
# Supabase (Render/prod): Supabase dashboard -> Connect -> Session pooler URI
# (port 5432, IPv4, works with migrate + app). Append ?schema=public if missing.
# Only use the Transaction pooler (6543) with ?pgbouncer=true&connection_limit=1.
POSTGRES_USER=bow
POSTGRES_PASSWORD=bowpass
POSTGRES_DB=bowdb
DATABASE_URL=postgresql://bow:bowpass@localhost:5432/bowdb?schema=public

# ---- API (apps/api, Render) ----
API_PORT=3001
JWT_SECRET=change-me-to-32-random-chars-minimum
JWT_EXPIRES_IN=7d
# '*' = allow all mail IDs (gmail, yahoo, college...). Or restrict: college.edu,cs.college.edu
ALLOWED_EMAIL_DOMAINS=*
# single emails bypassing domain check (comma-separated, for admins/demos)
ALLOWED_EMAIL_OVERRIDES=
# Prod: your Vercel URL (CSV allowed: https://projecthub.vercel.app,http://localhost:3000).
# Vercel preview deploys (*.vercel.app) and localhost are always allowed.
FRONTEND_URL=http://localhost:3000
# Extra origins without editing code (comma-separated).
FRONTEND_URLS_EXTRA=
# Cross-site cookies need SameSite=None + Secure (Vercel https -> Render https).
# Default: none in production, lax locally. Override only if you know why.
COOKIE_SAMESITE=
# local | supabase. Render/prod must be supabase (disk is ephemeral).
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# ---- Supabase (prod storage; screenshots bucket must be PUBLIC) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=screenshots

# ---- GitHub OAuth (optional for MVP; repos endpoint returns fixtures if unset) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ---- Web (apps/web, Vercel) ----
# Local: http://localhost:3001/api/v1 | Prod: https://<your-render-api>.onrender.com/api/v1
# Set in Vercel dashboard BEFORE building (NEXT_PUBLIC_ is baked at build time).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
